    "def SingleBarChartplt(column, label):\n",
    "    Column = column.value_counts()\n",
    "    fig, ax = plt.subplots(figsize=(7, 4))\n",
    "    ax.bar(Column.index, Column.values, color='#1a80bb', edgecolor='black')\n",
    "    ax.set_title(label)\n",
    "    ax.spines['top'].set_visible(False)\n",
    "    ax.spines['right'].set_visible(False)\n",
    "    plt.show()\n",
    "    \n",
    "    \n",
    "    \n",
    "def SingleBarChartPlotly(column, label):\n",
    "    fig = px.bar(\n",
    "        x=column.value_counts().index,\n",
    "        y=column.value_counts().values,\n",
    "        title=label\n",
    "        \n",
    "    )\n",
    "    fig.show()\n",
    "    \n",
    "   \n",
    "\n",
    "def SingleDonutplt(column, label):\n",
    "    Column = column.value_counts()\n",
    "    fig, ax = plt.subplots(figsize=(7,7))\n",
    "    ghach, name = ax.pie(Column.values, labels=Column.index, wedgeprops=dict(width=0.4), startangle=90)\n",
    "    ax.set_title(label)\n",
    "    plt.show()\n",
    "    \n",
    "    \n",
    "    \n",
    "    \n",
    "def SingleDonutPlotly(column, label):\n",
    "    Column = column.value_counts().reset_index()\n",
    "    fig = px.pie(Column, hole=0.45, title = label)\n",
    "    fig.show()\n",
    "    \n",
    "\n",
