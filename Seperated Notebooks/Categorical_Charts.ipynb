    "def ThreeColumnSummary(column1, column2, column3, label):\n",
    "\n",
    "    ct = df.groupby([column1.name, column2.name, column3.name]).size().reset_index(name='Count')\n",
    "\n",
    "    fig = px.treemap(\n",
    "        ct,\n",
    "        path=[column1.name, column2.name, column3.name],\n",
    "        values='Count',\n",
    "        color='Count',\n",
    "        color_continuous_scale='YlGnBu',\n",
    "        title=f\"{label} - Treemap\"\n",
    "    )\n",
    "    fig.update_layout(title_x=0.5, height=500)\n",
    "    fig.show()\n",
    "\n",
    "    ct2 = df.groupby([column1.name, column2.name, column3.name]).size().reset_index(name='Count')\n",
    "\n",
    "    fig_SVK = px.sunburst(\n",
    "        ct2,\n",
    "        path=[column1.name, column2.name, column3.name],\n",
