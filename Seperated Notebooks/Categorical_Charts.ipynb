    "def ColumnSummary(column, label):\n",
    "    counts = column.value_counts()\n",
    "    percent = (counts / counts.sum() * 100).round(2)\n",
    "    categories = counts.index.astype(str).tolist()\n",
    "\n",
    "    fig = make_subplots(\n",
    "        rows=1, cols=3,\n",
    "        column_widths=[0.35, 0.35, 0.30],\n",
    "        specs=[\n",
    "            [{\"type\": \"xy\"}, {\"type\": \"domain\"}, {\"type\": \"table\"}]\n",
    "        ],\n",
    "        subplot_titles=[f\"{label} - Bar\", f\"{label} - Donut\", f\"{label} - Frequency Table\"]\n",
    "    )\n",
    "\n",
    "    fig.add_trace(\n",
    "        go.Bar(x=categories, y=counts.values, name=\"Count\", showlegend=False),\n",
    "        row=1, col=1\n",
    "    )\n",
    "\n",
    "    fig.add_trace(\n",
    "        go.Pie(labels=categories, values=counts.values, hole=0.45, name=label),\n",
    "        row=1, col=2\n",
    "    )\n",
    "\n",
    "    fig.add_trace(\n",
    "        go.Table(\n",
    "            header=dict(\n",
    "                values=[\"Category\", \"Count\", \"Percent (%)\"],\n",
    "                fill_color=\"steelblue\",\n",
    "                font=dict(color=\"white\", size=12),\n",
    "                align=\"center\"\n",
    "            ),\n",
    "            cells=dict(\n",
    "                values=[categories, counts.values, percent.values],\n",
    "                fill_color=[[\"#f0f0f0\", \"#ffffff\"] * len(categories)],\n",
    "                align=\"center\"\n",
    "            )\n",
    "        ),\n",
    "        row=1, col=3\n",
    "    )\n",
    "\n",
    "    fig.update_layout(\n",
    "        title_text=f\"Summary: {label}\",\n",
    "        title_x=0.5,\n",
    "        height=420,\n",
    "    )\n",
    "\n",
    "    fig.show()\n",
    "\n",
    "# I didn't delete this one for test, You can see the Actual Usage on Datas_Charts_Categorical Inside Projects folder <3\n",
    "#ColumnSummary(df['Smoking'], 'Smoking Level')"
   ]
